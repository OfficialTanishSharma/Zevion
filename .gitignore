# === Zevion .gitignore ===

# --- Environment & secrets (NEVER commit API keys) ---
.env
.env.*
!.env.example
*.pem
*.key
server/.env
frontend/.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Frontend ---
node_modules/
dist/
build/
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- App runtime state (contains user data / API keys — do NOT commit) ---
.ai_desktop_settings.json
.ai_desktop_memory.json
.ai_desktop_conversations.json
.ai_desktop_usage.json
.ai_desktop_reminders.json
.ai_desktop_attachments/

# --- OS & editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Large / generated ---
model_weights/
*.zip
*.tar.gz
*.iso
