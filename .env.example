# Zevion — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in your real keys.
# NEVER commit the real `.env` — it is excluded by .gitignore.

# --- Server ---
PORT=8000
DEMO=true

# --- AI Provider API Keys (all optional) ---
# Zevion works fully offline with the built-in engine (no keys required).
# Add keys to enable intelligent responses & vision.
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# --- Limits ---
MAX_REQUESTS_PER_MINUTE=30

# --- Desktop paths (optional overrides) ---
# AI_DESKTOP_DIR=
# AI_DOWNLOADS_DIR=
# AI_DOCUMENTS_DIR=
# AI_WORKSPACE_ROOT=
